# Signaling server WebSocket URL (REQUIRED for production)
# This must point to your deployed signaling server
VITE_SIGNALING_URL=wss://your-app-name.b4a.run/ws

# Optional: ICE transport policy ('all' or 'relay'). Default: 'all'
# Set to 'relay' to force TURN relay (useful for testing NAT traversal)
# VITE_ICE_TRANSPORT_POLICY=all

# Optional: Log level (debug, info, warn, error). Default: 'info'
# VITE_LOG_LEVEL=info
